# -------------------------------------------------------------------
# Security & Directory Defaults
# -------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.html index.php

# Block access to backup, test, and sensitive developer files
<FilesMatch "(backup|\(1\)|tagore\.txt|\.log|\.env|\.sql)$">
    Require all denied
</FilesMatch>

# -------------------------------------------------------------------
# Canonical: Force HTTPS and non-www (https://tagoreautoparts.com)
# -------------------------------------------------------------------
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.tagoreautoparts\.com [NC]
RewriteRule ^(.*)$ https://tagoreautoparts.com/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://tagoreautoparts.com/$1 [L,R=301]

# -------------------------------------------------------------------
# Blog guide aliases
# -------------------------------------------------------------------
RewriteRule ^blog-pages/engine-guide/?$ /blog-pages/engine/ [R=301,L]
RewriteRule ^blog-pages/transmission-guide/?$ /blog-pages/transmission/ [R=301,L]
RewriteRule ^blog-pages/turbo-guide/?$ /blog-pages/turbo/ [R=301,L]
RewriteRule ^blog-pages/carparts-guide/?$ /blog-pages/carparts/ [R=301,L]

# -------------------------------------------------------------------
# Blog-pages category restructuring 301 redirects
# -------------------------------------------------------------------
RedirectMatch 301 ^/[Bb]log-[Pp]ages/blog-engine(\.html)?$ https://tagoreautoparts.com/blog-pages/engine/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/blog-transmission(\.html)?$ https://tagoreautoparts.com/blog-pages/transmission/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/blog-turbo(\.html)?$ https://tagoreautoparts.com/blog-pages/turbo/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/blog-carparts(\.html)?$ https://tagoreautoparts.com/blog-pages/carparts/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/tr-blog(\.html)?$ https://tagoreautoparts.com/blog-pages/engine/tr-blog
RedirectMatch 301 ^/[Bb]log-[Pp]ages/2025-buick-enclave(\.html)?$ https://tagoreautoparts.com/blog-pages/carparts/2025-buick-enclave
# Explicit redirects for existing blog posts
RedirectMatch 301 ^/[Bb]log-[Pp]ages/eng-(2|7|8|11)(\.html)?$ https://tagoreautoparts.com/blog-pages/engine/eng-$1
RedirectMatch 301 ^/[Bb]log-[Pp]ages/trans-(2|5|6|14)(\.html)?$ https://tagoreautoparts.com/blog-pages/transmission/trans-$1
RedirectMatch 301 ^/[Bb]log-[Pp]ages/turbo-(4|5|11|14)(\.html)?$ https://tagoreautoparts.com/blog-pages/turbo/turbo-$1
RedirectMatch 301 ^/[Bb]log-[Pp]ages/carpart-([2-9]|12|14)(\.html)?$ https://tagoreautoparts.com/blog-pages/carparts/carpart-$1

# Fallbacks for any other /Blog-pages/ posts -> respective category hub
RedirectMatch 301 ^/[Bb]log-[Pp]ages/eng-.*$ https://tagoreautoparts.com/blog-pages/engine/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/trans-.*$ https://tagoreautoparts.com/blog-pages/transmission/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/turbo-.*$ https://tagoreautoparts.com/blog-pages/turbo/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/carpart-.*$ https://tagoreautoparts.com/blog-pages/carparts/
RedirectMatch 301 ^/[Bb]log-[Pp]ages/?$ https://tagoreautoparts.com/blog-pages/engine/

# Internal category alias cleanups
Redirect 301 /blog-pages/engine/blog-engine https://tagoreautoparts.com/blog-pages/engine/
Redirect 301 /blog-pages/engine/engine-guide https://tagoreautoparts.com/blog-pages/engine/
Redirect 301 /blog-pages/transmission/blog-transmission https://tagoreautoparts.com/blog-pages/transmission/
Redirect 301 /blog-pages/transmission/transmission-guide https://tagoreautoparts.com/blog-pages/transmission/
Redirect 301 /blog-pages/turbo/blog-turbo https://tagoreautoparts.com/blog-pages/turbo/
Redirect 301 /blog-pages/turbo/turbo-guide https://tagoreautoparts.com/blog-pages/turbo/
Redirect 301 /blog-pages/carparts/blog-carparts https://tagoreautoparts.com/blog-pages/carparts/
Redirect 301 /blog-pages/carparts/carparts-guide https://tagoreautoparts.com/blog-pages/carparts/

# -------------------------------------------------------------------
# Shop & Other & Alternator redirects
# -------------------------------------------------------------------
RedirectMatch 301 ^/[Ee]ngines(\.html)?/?$ https://shop.tagoreautoparts.com/product-category/used-engine/
RedirectMatch 301 ^/[Tt]ransmission(\.html)?/?$ https://shop.tagoreautoparts.com/product-category/used-transmission/
Redirect 301 /shop https://shop.tagoreautoparts.com/
Redirect 301 /shop.html https://shop.tagoreautoparts.com/
Redirect 301 /other https://tagoreautoparts.com/
Redirect 301 /other.html https://tagoreautoparts.com/
Redirect 301 /what-is-an-alternator https://blog.tagoreautoparts.com/what-is-an-car-alternator/
Redirect 301 /what-is-an-alternator.html https://blog.tagoreautoparts.com/what-is-an-car-alternator/
Redirect 301 /transmissions/gmc-sierra-1500-transmission.html https://shop.tagoreautoparts.com/product-category/used-transmission/
Redirect 301 /transmissions/gmc-sierra-1500-transmission https://shop.tagoreautoparts.com/product-category/used-transmission/
Redirect 301 /transmissions/toyota-tundra-transmission.html https://shop.tagoreautoparts.com/product-category/used-transmission/
Redirect 301 /transmissions/toyota-tundra-transmission https://shop.tagoreautoparts.com/product-category/used-transmission/

# -------------------------------------------------------------------
# Clean URL rewriting
# -------------------------------------------------------------------
# 1. Strip index and index.html in any subdirectory to trailing slash
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/*(.+)/index(?:\.html)?[\s?] [NC]
RewriteRule ^(.*)index(?:\.html)?$ https://tagoreautoparts.com/%1/ [R=301,L]

# 2. Strip root /index and /index.html to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/+index(?:\.html)?[\s?] [NC]
RewriteRule ^index(?:\.html)?$ https://tagoreautoparts.com/ [R=301,L]

# 3. Strip .html extension from all other requests
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/*([^.]+)\.html[\s?] [NC]
RewriteRule ^([^.]+)\.html$ https://tagoreautoparts.com/$1 [R=301,L]

# 4. Internally rewrite non-extension URLs to their .html counterparts
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Direct access fallback for non-existent blog post URLs -> category hubs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^blog-pages/engine/eng-.*$ https://tagoreautoparts.com/blog-pages/engine/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^blog-pages/transmission/trans-.*$ https://tagoreautoparts.com/blog-pages/transmission/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^blog-pages/turbo/turbo-.*$ https://tagoreautoparts.com/blog-pages/turbo/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^blog-pages/carparts/carpart-.*$ https://tagoreautoparts.com/blog-pages/carparts/ [R=301,L]

ErrorDocument 404 /404.php

# -------------------------------------------------------------------
# Normalized URL redirects (lowercase & clean slugs)
# -------------------------------------------------------------------
Redirect 301 /Privacy-Policy https://tagoreautoparts.com/privacy-policy
Redirect 301 /Privacy-Policy.html https://tagoreautoparts.com/privacy-policy
Redirect 301 /Order-Status https://tagoreautoparts.com/order-status
