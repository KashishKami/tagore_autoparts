            "description": "Tagore Auto Parts supplies quality-tested used engines, used transmissions, and recycled OEM auto parts for domestic and foreign vehicles, backed by warranty and nationwide shipping.",
            "telephone": "+1 888-656-5933",
            "email": "support@tagoreautoparts.com",
            "priceRange": "$$",
            "address": {
            "@type": "PostalAddress",
            "streetAddress": "2700 Patriot Blvd",
            "addressLocality": "Glenview",
            "addressRegion": "IL",
            "postalCode": "60026",
            "addressCountry": "US"
            },
            "geo": {
            "@type": "GeoCoordinates",
            "latitude": 42.10468,
            "longitude": -87.82466
            },
            "openingHoursSpecification": [
            {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                "opens": "10:00",
                "closes": "18:00"
            }
            ],
            "areaServed": {
            "@type": "Country",
            "name": "United States"
            },
            "sameAs": [
            "https://www.facebook.com/tagoreusedparts/"
            ],
            "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Used Auto Parts",
