        // 4. Testimonials Carousel Initialization
        (function() {
            function initTestimonialCarousel() {
                if (typeof jQuery !== 'undefined' && jQuery.fn.owlCarousel) {
                    var $carousel = jQuery("#testmonial_carousel");
                    if ($carousel.length && !$carousel.hasClass('owl-loaded')) {
                        $carousel.owlCarousel({
                            items: 3,
                            loop: true,
                            margin: 24,
                            nav: true,
                            navText: ['<i class="fa fa-angle-left" aria-label="Previous"></i>', '<i class="fa fa-angle-right" aria-label="Next"></i>'],
                            dots: true,
                            autoplay: true,
                            autoplayTimeout: 5000,
                            autoplayHoverPause: true,
                            responsive: {
                                0: { items: 1, margin: 12 },
                                768: { items: 2, margin: 18 },
                                1024: { items: 3, margin: 24 }
                            }
                        });
                    }
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTestimonialCarousel);
            } else {
                initTestimonialCarousel();
            }
            window.addEventListener('load', initTestimonialCarousel);
        })();

        // 5. USA Map Hover Delivery Details Tooltip
        (function() {
            var detailsBox = document.getElementById('details-box');
            var mapPaths = document.querySelectorAll('#us-map path');
            var mapWrapper = document.querySelector('.map-wrapper');
            if (!detailsBox || !mapPaths.length || !mapWrapper) return;

            mapPaths.forEach(function(path) {
                path.addEventListener('mouseenter', function() {
                    var stateName = path.getAttribute('data-name') || path.id || 'Your State';
                    detailsBox.innerHTML = '<div style="font-weight:700;font-size:15px;margin-bottom:3px;color:#fff;">' + stateName + '</div><div style="color:#4ade80;font-size:13px;display:flex;align-items:center;gap:6px;"><i class="fa fa-truck"></i> Est. Delivery: 5-7 Days</div>';
                    detailsBox.classList.add('show');
                });

                path.addEventListener('mousemove', function(e) {
                    var rect = mapWrapper.getBoundingClientRect();
                    var x = e.clientX - rect.left;
                    var y = e.clientY - rect.top - 60;
                    detailsBox.style.left = x + 'px';
                    detailsBox.style.top = y + 'px';
                });

                path.addEventListener('mouseleave', function() {
                    detailsBox.classList.remove('show');
                });
            });
        })();
    </script>


</BaseLayout>