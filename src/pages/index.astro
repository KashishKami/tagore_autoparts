    <!-- ============================================== -->
    <!-- 🥩 DEFAULT SLOT: Page Body Goes Here Next!     -->
    <!-- ============================================== -->

    <!-- Quote Success Feedback Modal -->
    <div id="quote-success-modal" class="quote-modal-backdrop" style="display:none;">
        <div class="quote-modal-dialog">
            <button type="button" class="quote-modal-close" onclick="closeQuoteModal()" aria-label="Close modal">&times;</button>
            <div class="quote-modal-icon">
                <i class="fa fa-check"></i>
            </div>
            <div class="quote-modal-title">Quote Request Received!</div>
            <p class="quote-modal-vehicle">
                We are checking nationwide salvage inventory for your <strong id="modal-vehicle-part">Requested Part</strong>.
            </p>
            <p class="quote-modal-subtext">
                Our automotive parts specialist will call or text you shortly at <strong id="modal-phone-display">your phone number</strong> with pricing and warranty options.
            </p>
            <div class="quote-modal-actions">
                <a href="tel:+18886565933" class="quote-modal-call-btn">
                    <i class="fa fa-phone"></i> Call Now for Immediate Quote
                </a>
                <button type="button" class="quote-modal-done-btn" onclick="closeQuoteModal()">Done</button>
            </div>
        </div>
    </div>

<!-- Hero Quote Section with 5 Fading Images -->
<section class="hero-quote-section">
    <div class="hero-bg-crossfade">
