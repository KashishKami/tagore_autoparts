---
// ==============================================================
// TOP FLOOR: Imports & Homepage Metadata
// ==============================================================

import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Tagore AutoParts | Used Engines, Transmissions & Turbos";
const pageDescription = "Tagore AutoParts for top-quality used engines and transmissions. Enjoy unbeatable prices, 24/7 support, and fast shipping. Find your perfect part now!";
const pageKeywords = "Used Transmissions Prices, Quality used Engine, turbo charging, turbo charged engine, turbo charger for car, turbo charger price, car engine turbocharger, Quality Used Transmissions, Used Engines For Sale";
const canonicalUrl = "https://tagoreautoparts.com/";

---

<!-- ============================================================ -->
<!-- GROUND FLOOR: Master Frame Wraps the Entire Page             -->
<!-- ============================================================ -->

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    canonical={canonicalUrl}
    activeNav="home"
>
    <!-- ================================================= -->
    <!-- 📬 NAMED SLOT: Homepage-Specific <head> Assets    -->
    <!-- ================================================= -->
    <Fragment slot="head">
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://tagoreautoparts.com/" />
        <meta property="og:title" content="Tagore AutoParts | Used Engines, Transmissions & Turbos" />
        <meta property="og:description" content="Tagore AutoParts for top-quality used engines and transmissions. Enjoy unbeatable prices, 24/7 support, and fast shipping. Find your perfect part now!" />
        <meta property="og:image" content="https://tagoreautoparts.com/Front%20Banners/Home.jpg" />
        <meta property="og:site_name" content="Tagore Auto Parts" />
        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content="https://tagoreautoparts.com/" />
        <meta name="twitter:title" content="Tagore AutoParts | Used Engines, Transmissions & Turbos" />
        <meta name="twitter:description" content="Tagore AutoParts for top-quality used engines and transmissions. Enjoy unbeatable prices, 24/7 support, and fast shipping. Find your perfect part now!" />
