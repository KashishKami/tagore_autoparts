            .hero-btn-primary, .hero-btn-primary:hover, .hero-btn-primary:focus, .hero-btn-primary:active,
            .hero-btn-secondary, .hero-btn-secondary:hover, .hero-btn-secondary:focus, .hero-btn-secondary:active {
                transform: none !important;
                -webkit-transform: none !important;
                -moz-transform: none !important;
                -ms-transform: none !important;
                scale: 1 !important;
                zoom: 1 !important;
                width: auto !important;
                height: auto !important;
            }
        </style>
        <!-- Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-9YRJQKQXP4" is:inline></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-9YRJQKQXP4');
