        <div class="slide-img" style="background-image: url('/Front Banners/Home (2).jpg');"></div>
        <div class="slide-img" style="background-image: url('/Front Banners/Home (3).jpg');"></div>
        <div class="slide-img" style="background-image: url('/Front Banners/Home (4).jpg');"></div>
        <div class="slide-img" style="background-image: url('/Front Banners/Home (5).jpg');"></div>
    </div>
    <div class="hero-bg-crossfade-overlay"></div>

    <div class="hero-quote-container" style="position:relative; z-index:3;">
        <!-- Left Column: Content -->
        <div class="hero-content">
            <span class="hero-badge"><i class="fa fa-truck" style="margin-right: 6px;"></i> SERVING ALL 48 CONTIGUOUS STATES</span>
            <h1 class="hero-title">
                Used <span class="hero-title-red">Engines</span> & <span class="hero-title-red">Transmissions</span> for Sale in USA
            </h1>
            <p class="hero-description">
                America's most trusted supplier for quality <strong>used engines</strong> and <strong>used transmissions for sale</strong>. 
                Over 1,500+ engines and 1,000+ transmissions in stock — backed by a 90-day warranty and fast nationwide delivery.
            </p>
            
            <div class="hero-features">
                <div class="hero-feature">
                    <i class="fa fa-check-circle"></i>
                    <span>90-Day Warranty</span>
                </div>
                <div class="hero-feature">
                    <i class="fa fa-check-circle"></i>
                    <span>1,500+ Engines</span>
                </div>
                <div class="hero-feature">
                    <i class="fa fa-check-circle"></i>
                    <span>1,000+ Transmissions</span>
                </div>
                <div class="hero-feature">
                    <i class="fa fa-check-circle"></i>
                    <span>Same-Day Quotes</span>
                </div>
            </div>
            
            <div class="hero-buttons">
                <a href="tel:+18886565933" class="hero-btn hero-btn-primary">
                    <i class="fa fa-phone" style="margin-right: 8px;"></i> Call Us
                </a>
                <a href="https://shop.tagoreautoparts.com" class="hero-btn hero-btn-secondary">Browse Inventory</a>
            </div>
        </div>
        
        <!-- Right Column: Quote Form (Dark) -->
        <div class="hero-form-wrapper">
            <div class="hero-form-card">
                <h2 class="hero-form-title">Get a Free Quote Instantly</h2>
                <form action="/leads-form.php" method="POST" class="hero-quote-form">
                    <div class="hero-form-row">
                        <div class="hero-form-field">
                            <label for="quote-name">YOUR NAME</label>
                            <input type="text" id="quote-name" name="name" placeholder="Your Name" required>
                        </div>
                        <div class="hero-form-field">
                            <label for="quote-phone">PHONE NUMBER</label>
                            <input type="tel" id="quote-phone" name="phone" placeholder="(555) 000-0000" required>
                        </div>
                    </div>

                    <div class="hero-form-row">
                        <div class="hero-form-field">
                            <label for="quote-year">YEAR</label>
                            <input type="text" id="quote-year" name="year" placeholder="Select Year" required>
                        </div>
                        <div class="hero-form-field">
                            <label for="quote-part">PART TYPE</label>
                            <select id="quote-part" name="part" required>
                                <option value="">Select Part</option>
                                <option value="Engine">Engine</option>
                                <option value="Transmission">Transmission</option>
                                <option value="Turbo">Turbo</option>
                                <option value="Other">Other Auto Part</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="hero-form-field hero-form-field-full">
                        <label for="quote-make-model">MAKE &amp; MODEL</label>
                        <input type="text" id="quote-make-model" name="make_model" placeholder="e.g. Ford F-150, Chevy Silverado" required>
                    </div>

                    <div class="hero-form-field hero-form-field-full">
                        <label for="quote-email">YOUR EMAIL</label>
                        <input type="email" id="quote-email" name="email" placeholder="Enter your email address" required>
                    </div>
                    
                    <div class="hero-form-consent" style="display: flex; flex-direction: column; gap: 8px; margin: 8px 0 12px 0;">
                        <div style="display: flex; align-items: flex-start; gap: 8px;">
                            <input type="checkbox" id="hero-opt-out" name="opt_out" style="margin-top: 3px; accent-color: #b71c1b;">
                            <label for="hero-opt-out" style="font-size: 11.5px; color: #64748b; cursor: pointer; margin: 0;">Opt out of promotional communications</label>
                        </div>
                        <div style="display: flex; align-items: flex-start; gap: 8px;">
                            <input type="checkbox" id="hero-consent" name="consent" required style="margin-top: 3px; accent-color: #b71c1b;">
                            <label for="hero-consent" style="font-size: 11.5px; color: #64748b; cursor: pointer; margin: 0; line-height: 1.4;">
                                By providing your phone number, you consent to receive text messages from Tagore Fusion LLC for purposes related to our services. Message frequency may vary. Reply HELP for help or STOP to unsubscribe. See our <a href="/privacy-policy.html">privacy policy</a>.
                            </label>
                        </div>
                    </div>
                    
                    <button type="submit" class="hero-submit-btn">
                        Get Free Quote &amp; Call Back
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

