---
// ==============================================================
// TOP FLOOR: Import Master Layout & Define Checkout SEO Metadata
// ==============================================================

import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Fast and Reliable Auto Parts Shipping | Tagore AutoParts";
const pageDescription = "Complete your purchase at Tagore AutoParts with our secure checkout process. Provide part details, shipping and billing addresses, and payment information.";
const pageKeywords = "Used Transmissions Prices, Quality used Engine, Quality Used Transmissions, Used Engines For Sale";
const canonicalUrl = "https://tagoreautoparts.com/checkout.html";

---

<!-- ============================================================ -->
<!-- GROUND FLOOR: The Master Frame wraps the page                -->
<!-- ============================================================ -->

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    canonical={canonicalUrl}
    activeNav="checkout"
>
    <!-- ================================================= -->
    <!-- 📬 NAMED SLOT: Checkout Schema Markup             -->
    <!-- ================================================= -->
    <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Checkout - Tagore Auto Parts",
      "url": "https://tagoreautoparts.com/checkout.html",
      "description": "Complete your order and payment securely for quality used auto parts at Tagore Auto Parts.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://tagoreautoparts.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Checkout",
            "item": "https://tagoreautoparts.com/checkout.html"
          }
        ]
      },
      "publisher": {
        "@type": "AutoPartsStore",
        "name": "Tagore Auto Parts",
        "url": "https://tagoreautoparts.com/"
      }
    }
    </script>

    <!-- ============================================== -->
    <!-- 🥩 DEFAULT SLOT: Checkout Form Goes Here Next! -->
    <!-- ============================================== -->

    <!-- ##### Breadcumb Area Start ##### -->
<div class="breadcumb_area">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <div class="page-title text-center">
                    <span class="legal-badge"><i class="fa fa-shield"></i> Direct Order &amp; Reservation Request</span>
                    <h1>Secure Order Checkout</h1>
                    <p class="legal-subtitle">Complete Your Auto Part Order &amp; Lock In Your 90-Day Nationwide Warranty</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ##### Breadcumb Area End ##### -->

<div class="custom-form-container">
  <div class="three-d-checkout-form">
    <form action="/checkout_process.php" method="post">
      <h1 class="form-title">Checkout</h1>

      <!-- Part Information Section -->
      <fieldset>
        <legend>Part Information</legend>
        <div class="form-row">
          <div class="form-group">
            <label for="year">Year</label>
            <input type="text" id="year" name="year" placeholder="Enter Year (e.g., 2000)" required>
          </div>
          <div class="form-group">
            <label for="make_model">Make & Model</label>
            <input type="text" id="make_model" name="Make&model" placeholder="Dodge or Similar" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="product_type">Product Type</label>
            <input type="text" id="product_type" name="product_type" placeholder="Engine/Transmission" required>
          </div>
          <div class="form-group">
            <label for="Specification">Specification</label>
            <input type="text" id="Specification" name="Specification" placeholder="Optional Details">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="vin_number">VIN Number</label>
            <input type="text" id="vin_number" name="vin_number" placeholder="Vehicle Identification Number" required>
          </div>
          <div class="form-group">
            <label for="agent_name">Agent Name/Extension</label>
            <input type="text" id="agent_name" name="agent_name" placeholder="Optional Details">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="miles_by_agent">Miles Given by Agent</label>
            <input type="text" id="miles_by_agent" name="miles_by_agent" placeholder="e.g., 65,000 miles">
          </div>
          <div class="form-group">
            <label for="price_by_agent">Price Given by Agent</label>
            <input type="text" id="price_by_agent" name="price_by_agent" placeholder="e.g., $1,250.00">
          </div>
        </div>
      </fieldset>

      <!-- Shipping Address Section -->
<fieldset>
  <legend>Shipping Address</legend>
  <div class="form-row">
    <div class="form-group">
      <label for="fname">Full Name</label>
      <input type="text" id="fname" name="firstname" placeholder="John M. Doe" required>
    </div>
    <div class="form-group">
      <label for="email">Email (Optional)</label>
      <input type="email" id="email" name="email" placeholder="example@example.com">
    </div>
    <div class="form-group">
      <label for="address_type">Address Type</label>
      <input type="text" id="address_type" name="address_type" placeholder="Residential/Commercial" required>
    </div>
  </div>
  <div class="form-group">
    <label for="adr">Address</label>
    <input type="text" id="adr" name="address" placeholder="Street Address" required>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="city">City</label>
      <input type="text" id="city" name="city" placeholder="City" required>
    </div>
    <div class="form-group">
      <label for="state">State</label>
      <input type="text" id="state" name="state" placeholder="State" required>
    </div>
    <div class="form-group">
      <label for="zip">Zip Code</label>
      <input type="text" id="zip" name="zip" placeholder="Zip Code" required>
    </div>
    <div class="form-group">
      <label for="phn">Contact Number</label>
      <input type="text" id="phn" name="phone_number" placeholder="(123) 456-7890" required>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="shop_name">Shop Name</label>
      <input type="text" id="shop_name" name="shop_name" placeholder="Optional">
    </div>
    <div class="form-group">
      <label for="lift_gate">Lift Gate Needed</label>
      <select id="lift_gate" name="lift_gate">
        <option value="">Select an Option</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
      </select>
    </div>
  </div>
</fieldset>

      <!-- Billing Address Section -->
      <fieldset>
        <legend>Billing Address</legend>
        <div class="form-row">
          <div class="form-group">
            <label for="billing_fullname">Full Name</label>
            <input type="text" id="billing_fullname" name="billing_fullname" placeholder="John M. Doe" required>
          </div>
          <div class="form-group">
            <label for="billing_zip">Zip</label>
            <input type="text" id="billing_zip" name="billing_zip" placeholder="10001" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="billing_city">City</label>
            <input type="text" id="billing_city" name="billing_city" placeholder="New York" required>
          </div>
          <div class="form-group">
            <label for="billing_state">State</label>
            <input type="text" id="billing_state" name="billing_state" placeholder="NY" required>
          </div>
        </div>
        <div class="form-row">

          <div class="form-group">
            <label for="billing_address">Address</label>
            <input type="text" id="billing_address" name="billing_address" placeholder="542 W. 15th Street" required>
          </div>
        </div>
      </fieldset>

      <!-- Payment Details Section -->
      <fieldset>
        <legend>Payment Details</legend>
        <div class="form-row">
          <div class="form-group">
            <label for="cname">Name on Card</label>
            <input type="text" id="cname" name="cardname" placeholder="Cardholder Name" required>
          </div>
          <div class="form-group">
            <label for="ccnum">Card Number</label>
            <input type="text" id="ccnum" name="cardnumber" placeholder="1234 5678 9012 3456" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="expmonth">Exp Month</label>
            <input type="text" id="expmonth" name="expmonth" placeholder="MM" required>
          </div>
          <div class="form-group">
            <label for="expyear">Exp Year</label>
            <input type="text" id="expyear" name="expyear" placeholder="YYYY" required>
          </div>
          <div class="form-group">
            <label for="cvv">CVV</label>
            <input type="text" id="cvv" name="cvv" placeholder="3-digit code" required>
          </div>
        </div>
      </fieldset>

      <!-- Receipt-Style Part Price Summary -->
      <div class="receipt-price-card">
        <div class="receipt-price-header">
          <span class="receipt-price-title"><i class="fa fa-file-text-o"></i> Part Price Summary</span>
        </div>
        <div class="receipt-price-body">
          <div class="receipt-price-row">
            <span class="receipt-price-label">Part Price</span>
            <span class="receipt-price-amount" id="receiptPartPrice">$0.00</span>
          </div>
        </div>
      </div>

      <!-- Terms and Conditions -->
      <div class="form-group terms">
        <label>
          <input type="checkbox" name="terms_conditions" required>
          I agree with the <a href="/terms-and-conditions.html">terms and conditions</a>.
        </label>
      </div>

      <!-- Message Box -->
      <div class="form-group">
        <label for="message">Additional Message</label>
        <textarea id="message" name="message" rows="4" placeholder="Any special instructions or message"></textarea>
      </div>

      <!-- Proceed to Checkout Button -->
      <button type="submit" class="submit-button">Proceed to Checkout</button>
    </form>
  </div>
</div>



<!--------------------------------------------------------------Checkout Area End ------------------------------------------->


     <!-------------------------------------------- Start Shipping Info--------------------------------------------->

     <section class="shipping-info">
        <div class="container">
          <ul>
            <!-- Free Shipping -->
            <li>
              <div class="media-icon">
                <i class="lni lni-delivery"></i>
              </div>
              <div class="media-body">
                <h5>Nationwide </h5>
                <span>Shipping</span>
              </div>
            </li>
            <!-- Money Return -->
            <li>
              <div class="media-icon">
                <i class="lni lni-support"></i>
              </div>
              <div class="media-body">
                <h5>24/7 Support.</h5>
                <span>Chat Or Call.</span>
              </div>
            </li>
            <!-- Support 24/7 -->
            <li>
              <div class="media-icon">
                <i class="lni lni-credit-cards"></i>
              </div>
              <div class="media-body">
                <h5>Online Payment.</h5>
                <span>Secure Payment Services.</span>
              </div>
            </li>
            <!-- Safe Payment -->
            <li>
              <div class="media-icon">
                <i class="lni lni-reload"></i>
              </div>
              <div class="media-body">
                <h5>Easy Return.</h5>
                <span>Hassle Free Shopping.</span>
              </div>
            </li>
          </ul>
        </div>
      </section>

</BaseLayout>