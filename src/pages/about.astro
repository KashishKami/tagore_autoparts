                <div class="why-choose-center-image">
                    <img src="/img/why choos us/cu.png" alt="Support" class="rounded-circle">
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="pl-md-3">
                    <div class="text-center text-sm-left mb-2-9">
                        <div class="mb-4">
                            <img src="/img/why choos us/call.png" alt="call us " class="rounded-circle">
                        </div>
                        <h4 class="sub-info">24/7 support</h4>
