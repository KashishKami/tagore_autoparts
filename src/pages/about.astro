---
// ==============================================================
// TOP FLOOR: Import Master Layout & Define SEO metadata
// ==============================================================

import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Your Source for Quality Used Engines and Transmissions";
const pageDescription = "With access to the largest database in the US, we provide affordable prices, exceptional customer service, and nationwide shipping. Tagore auto parts";
const pageKeywords = "Used Tranmissions Prices, Quality used Engine, turbo charging, turbo charged engine, turbo charger for car, turbo charger price, car engine turbocharger, Quality Used Transmissions, Used Engines For Sale";
const canonicalUrl = "https://tagoreautoparts.com/about.html";
---

<!-- ============================================================ -->
<!-- GROUND FLOOR: The Master Frame wraps the page                -->
<!-- ============================================================ -->

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    keywords={pageKeywords}
    canonical={canonicalUrl}
    activeNav="about"
>
    
    <!-- ================================================= -->
    <!-- 📬 NAMED SLOT: Schema Markup injected into <head> -->
    <!-- ================================================= -->
    <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Us - Tagore Auto Parts",
      "url": "https://tagoreautoparts.com/about.html",
      "description": "Tagore Auto Parts supplies quality-tested used engines, used transmissions, and recycled OEM auto parts for domestic and foreign vehicles, backed by warranty and nationwide shipping.",
      "mainEntity": {
        "@type": "AutoPartsStore",
        "name": "Tagore Auto Parts",
        "url": "https://tagoreautoparts.com/",
        "telephone": "+1 888-656-5933",
        "email": "support@tagoreautoparts.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "2700 Patriot Blvd",
          "addressLocality": "Glenview",
          "addressRegion": "IL",
          "postalCode": "60026",
          "addressCountry": "US"
        }
      }
    }
    </script>

    <!-- ============================================== -->
    <!-- 🥩 DEFAULT SLOT: The Unique About Us Content! -->
    <!-- ============================================== -->

    <!-- ##### Breadcrumb Area Start ##### -->
    <div class="breadcumb_area">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10">
                    <div class="page-title text-center">
                        <span class="legal-badge"><i class="fa fa-info-circle"></i> Who We Are</span>
                        <h1>About Tagore Auto Parts</h1>
                        <p class="legal-subtitle">America's Leading Supplier of Tested, Low-Mileage OEM Engines &amp; Transmissions</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ##### Breadcrumb Area End ##### -->

    <div class="about-us-area section-padding-100-0">
        <div class="container">
            <div class="row">
                <div class="col-12 col-lg-6">
                    <div class="about-content">
                        <h2>Welcome to our <span>Tagore AutoParts</span></h2>
                        <p>
                            Tagore Auto Part has access to the most extensive and largest database of used engines in
                            the United States. Possessing a large inventory allows us to pass on the best value and the
                            highest quality. We offer due to our extensive network of stocks. We have the old engine you
                            require and can transport it to any US state, regardless of what kind of vehicle you
                            drive&mdash;SUVs, large trucks, sports cars, or anything else you can think of.
                            To make sure you acquire the correct parts for your car, we offer encountered knowledge for all
                            of your needs. Our objective is to locate the highest caliber engines at the most affordable
                            cost as soon as feasible. We have access to thousands of salvage and junkyards' worth of
                            goods countrywide thanks to our distinctive and vast automotive network.
                            You can place your order with us by utilizing our website, calling us at <b>+1
                                888-656-5933</b>, or by filling out the form on Contact Us. A sales representative will
                            then get in contact with you right away to assist you.
                        </p>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="about-content">
                        <p>The company was established with the goal of providing quality aftermarket auto parts at
                            affordable prices. We have an entire staff of sales and customer service representatives
                            working in our fully staffed retail store and warehouse. Our customer care representatives are
                            available on phone or email for help with any inquiries you may have, and our website is
                            simple to use. Our goal is to provide you the greatest parts at the best available cost
                            while providing the highest level of client support. In the end, our main goal is to assist
                            you.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br>

    <a href="/checkout.html" class="sticky-button">Place an order</a>

    <!-- ##### Stats Cards Area ##### -->
    <div class="container">
        <div class="row ">
            <div class="col-xl-6 col-lg-6">
                <div class="card l-bg-cherry">
                    <div class="card-statistic-3 p-4">
                        <div class="card-icon card-icon-large"><i class="fa fa-shopping-cart"></i></div>
                        <div class="mb-4">
                            <h5 class="card-title mb-0">New Orders</h5>
                        </div>
                        <div class="row align-items-center mb-2 d-flex">
                            <div class="col-8">
                                <h2 class="d-flex align-items-center mb-0">
                                    7,189
                                </h2>
                            </div>
                            <div class="col-4 text-right">
                                <span>12.5% <i class="fa fa-arrow-up"></i></span>
                            </div>
                        </div>
                        <div class="progress mt-1 " data-height="8" style="height: 8px;">
                            <div class="progress-bar l-bg-cyan" role="progressbar" data-width="25%" aria-valuenow="25"
                                aria-valuemin="0" aria-valuemax="100" style="width: 25%;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6">
                <div class="card l-bg-blue-dark">
                    <div class="card-statistic-3 p-4">
                        <div class="card-icon card-icon-large"><i class="fa fa-users"></i></div>
                        <div class="mb-4">
                            <h5 class="card-title mb-0">Customers</h5>
                        </div>
                        <div class="row align-items-center mb-2 d-flex">
                            <div class="col-8">
                                <h2 class="d-flex align-items-center mb-0">
                                    130k
                                </h2>
                            </div>
                            <div class="col-4 text-right">
                                <span>9.23% <i class="fa fa-arrow-up"></i></span>
                            </div>
                        </div>
                        <div class="progress mt-1 " data-height="8" style="height: 8px;">
                            <div class="progress-bar l-bg-green" role="progressbar" data-width="25%" aria-valuenow="25"
                                aria-valuemin="0" aria-valuemax="100" style="width: 25%;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6">
                <div class="card l-bg-green-dark">
                    <div class="card-statistic-3 p-4">
                        <div class="card-icon card-icon-large"><i class="fa fa-ticket"></i></div>
                        <div class="mb-4">
                            <h5 class="card-title mb-0">Order Confirm</h5>
                        </div>
                        <div class="row align-items-center mb-2 d-flex">
                            <div class="col-8">
                                <h2 class="d-flex align-items-center mb-0">
                                    125k
                                </h2>
                            </div>
                            <div class="col-4 text-right">
                                <span>10% <i class="fa fa-arrow-up"></i></span>
                            </div>
                        </div>
                        <div class="progress mt-1 " data-height="8" style="height: 8px;">
                            <div class="progress-bar l-bg-orange" role="progressbar" data-width="25%" aria-valuenow="25"
                                aria-valuemin="0" aria-valuemax="100" style="width: 25%;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6">
                <div class="card l-bg-orange-dark">
                    <div class="card-statistic-3 p-4">
                        <div class="card-icon card-icon-large"><i class="fa fa-dollar"></i></div>
                        <div class="mb-4">
                            <h5 class="card-title mb-0">Part Shipped</h5>
                        </div>
                        <div class="row align-items-center mb-2 d-flex">
                            <div class="col-8">
                                <h2 class="d-flex align-items-center mb-0">
                                    124k
                                </h2>
                            </div>
                            <div class="col-4 text-right">
                                <span>52.5% <i class="fa fa-arrow-up"></i></span>
                            </div>
                        </div>
                        <div class="progress mt-1 " data-height="8" style="height: 8px;">
