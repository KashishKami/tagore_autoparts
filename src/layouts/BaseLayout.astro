---
//======================
//     Top Floor
//======================

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 1. Props contract with safe fallbacks 
const {
    title = "Tagore AutoParts | OEM Used Engines & Transmissions",
    description = "Quality-tested used engines and transmissions with nationwide shipping.",
    keywords = "Used Engines, Used Transmissions, OEM Auto Parts",
    canonical = "",
    activeNav = ""
} = Astro.props;


// 2. Central phone for the pop up modal
const salesPhone = "+1 (888) 656-5933";
const salesPhoneTel = "+18886565933";

---

<!--===================-->
<!--    Ground Floor   -->
<!--===================-->


<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta charset="UTF-8">
    <meta name="description" content={description}>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="keywords" content={keywords}>
    <meta name="author" content="tagoreautoparts">

    <title>{title}</title>

    <!-- Favicon & Stylesheets (Root-Relative: Gem 12, Section 4) -->
    <link rel="icon" href="/img/core-img/favicon.jpg">
    <link rel="stylesheet" href="/css/LineIcons.3.0.css">
    <link rel="stylesheet" href="/css/core-style.css?v=2.1">
    <link rel="stylesheet" href="/css/site-polish.css?v=2.5">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- Google Tag Manager -->
    <script is:inline>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start': new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-KS4SG8NK');
    </script>
    <!-- End Google Tag Manager -->

    <!-- 📬 NAMED SLOT: Allows pages to inject custom Schema or extra meta into <head> -->
    <slot name="head" />
</head>

<body class="has-modern-header">

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KS4SG8NK" height="0" width="0"
            style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- 🍞 TOP BUN: Header Component -->
    <Header activeNav={activeNav} />

    <!-- 🥩 THE RESERVED LANDING PAD: Page Content Lands Here! -->
    <slot />

    <!-- Global Slide-Out Cart Drawer -->
    <div class="cart-bg-overlay"></div>
    <div class="right-side-cart-area">
        <div class="cart-button">
            <a href="#" id="rightSideCart"><img src="/img/core-img/bag.svg" alt="Cart"> <span class="cart-count"></span></a>
        </div>
        <div class="cart-container" id="cartContainer">
            <div class="cart-items" id="cartItems"></div>
            <div class="cart-total" style="display: flex; flex-direction: column; align-items: center;">
                <p style="text-align: center;">Total: <span id="cartTotal" style="font-weight: bold; color: #239636;">$0.00</span></p>
                <a href="/checkout.html" class="btn essence-btn">Check out</a>
            </div>
        </div>
    </div>


    <!-- 🍞 BOTTOM BUN: Footer Component -->
    <Footer />

    <!-- Pop-up Call Banner (Centralized in Master Layout) -->
    <div id="popup" class="popup">
        <div class="popup-content">
            <span class="close-btn" id="close-btn">&times;</span>
            <div class="popup-banner">
                <h2>What are you waiting for?</h2>
                <p class="phone-number">Get in touch: <strong>{salesPhone}</strong></p>
                <blockquote>"Get Quality Used Engine & Transmission"</blockquote>
                <button class="call-button" onclick={`window.location.href='tel:${salesPhoneTel}'`}>Call Now!</button>
            </div>
        </div>
    </div>

    <!-- Global JavaScript Plugins (is:inline preserves legacy script execution order) -->
    <script src="/js/jquery/jquery-2.2.4.min.js" is:inline></script>
    <script src="/js/popper.min.js" is:inline></script>
    <script src="/js/bootstrap.min.js" is:inline></script>
    <script src="/js/plugins.js" is:inline></script>
    <script src="/js/classy-nav.min.js" is:inline></script>
    <script src="/js/active.js" is:inline></script>
    <script src="/js/cart.js" is:inline></script>
    <script src="/js/header-nav.js?v=2.5" is:inline></script>

    <!-- Popup Banner Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            const popup = document.getElementById('popup');
            const closeBtn = document.getElementById('close-btn');
            if (!popup || !closeBtn) return;
            const pageName = window.location.pathname.split('/').pop() || 'index';

            function showPopup() {
                popup.style.display = 'flex';
            }

            function hidePopup() {
                popup.style.display = 'none';
            }

            const popupShown = sessionStorage.getItem(`popupShown_${pageName}`);
            if (!popupShown) {
                setTimeout(showPopup, 9000);
                sessionStorage.setItem(`popupShown_${pageName}`, 'true');
            }

            closeBtn.addEventListener('click', function () {
                hidePopup();
            });

            window.addEventListener('click', function (event) {
                if (event.target === popup) {
                    hidePopup();
                }
            });
        });
    </script>
</body>

</html>